# ──────────────────────────────────────────────────
# Smart Freight Intelligence Platform — Environment
# Copy to .env and fill in your values
# ──────────────────────────────────────────────────

# Application
APP_NAME="Smart Freight Intelligence Platform"
DEBUG=false
SECRET_KEY=CHANGE-ME-USE-A-LONG-RANDOM-STRING-AT-LEAST-32-CHARS

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# SQLite (default — for local dev, no setup needed):
DATABASE_URL=sqlite+aiosqlite:///./smart_freight.db

# PostgreSQL (for production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/smart_freight

# Redis (optional — required for Celery background tasks)
# If not set, background tasks won't run automatically
# REDIS_URL=redis://localhost:6379/0

# Neo4j (optional — required for supply-chain graph queries)
# If not set, graph endpoints return a documented fallback response
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your-neo4j-password

# CORS origins (comma-separated in prod, list in code)
# Default allows Vite dev server
